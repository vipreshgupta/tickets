# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://tambola:tambola_secret@localhost:5432/tambola_db

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ─── QR Code / Ticket Verification ─────────────────────────────────
HMAC_SECRET=change-me-to-another-random-64-char-string

# ─── Server ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Storage ────────────────────────────────────────────────────────
STORAGE_PATH=./storage

# ─── Upload Limits ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ─── Batch Limits ──────────────────────────────────────────────────
MAX_BATCH_QUANTITY=5000
BATCH_EXPIRY_DAYS=7

# ─── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_BATCHES=5
