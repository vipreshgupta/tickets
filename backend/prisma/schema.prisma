// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ─────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  templates    Template[]
  batches      Batch[]

  @@map("users")
}

// ─── Templates ─────────────────────────────────────────────────────

model Template {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  name               String
  backgroundImageUrl String   @map("background_image_url")
  zones              Json     // Array of 15 zone objects: { x, y, width, height, column_index, font, font_size, color, align }
                              // Coordinates stored as percentages of the background image's native dimensions
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@index([userId])
  @@map("templates")
}

// ─── Batches ───────────────────────────────────────────────────────

enum BatchStatus {
  queued
  generating_numbers
  rendering_images
  building_pdf
  building_zip
  complete
  failed
  cancelled
}

model Batch {
  id              String      @id @default(uuid())
  templateId      String?     @map("template_id")
  userId          String?     @map("user_id")
  quantity        Int
  status          BatchStatus @default(queued)
  progressPercent Int         @default(0) @map("progress_percent")
  pdfUrl          String?     @map("pdf_url")
  zipUrl          String?     @map("zip_url")
  errorReason     String?     @map("error_reason")
  // Inline template data for guest/one-off generation (no saved template)
  inlineTemplate  Json?       @map("inline_template") // { backgroundImageUrl, zones }
  createdAt       DateTime    @default(now()) @map("created_at")
  expiresAt       DateTime    @map("expires_at")

  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets  Ticket[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("batches")
}

// ─── Tickets ───────────────────────────────────────────────────────

model Ticket {
  id          String  @id @default(uuid())
  batchId     String  @map("batch_id")
  ticketIndex Int     @map("ticket_index")
  numbers     Json    // 3×9 grid: number[][] (0 = blank cell)
  qrSignature String  @map("qr_signature")
  imageUrl    String? @map("image_url")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, ticketIndex])
  @@index([batchId])
  @@index([qrSignature])
  @@map("tickets")
}
